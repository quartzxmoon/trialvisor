{
    "name": "trialvisor",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit --noUnusedLocals false --noUnusedParameters false",
        "typecheck:billing": "tsc -p tsconfig.billing.json",
        "typecheck:backend": "tsc -p tsconfig.backend.json",
        "verify": "npm run typecheck && npm run typecheck:billing && npm run typecheck:backend && npm run build"
    },
    "dependencies": {
        "lucide-react": "^0.469.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "stripe": "^22.6.1"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "^4.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.3.0",
        "autoprefixer": "^10.4.0",
        "postcss": "^8.4.0",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.7.0",
        "vite": "^6.0.0"
    }
}
